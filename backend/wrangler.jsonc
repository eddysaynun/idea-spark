{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-spark",
  "main": "worker.py",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],
  "python_modules": {
    "excludes": [
      "**/*.pyc",
      "**/__pycache__"
    ]
  },
  "routes": [
    {
      "pattern": "idea-spark.heyedwardchen.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  }
}
